<div class="skeleton-list">
    @for (int i = 0; i < Rows; i++)
    {
        <div class="skeleton-row">
            <div class="skeleton-bar skeleton-bar-wide"></div>
            <div class="skeleton-bar skeleton-bar-narrow"></div>
        </div>
    }
</div>
@code {
    [Parameter] public int Rows { get; set; } = 3;
}
