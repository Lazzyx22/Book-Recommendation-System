@page "/reading-twin/{ReaderId}"
@inject RecommendationRepository Repo
@inject FollowRepository FollowRepo
@using BookRecommendationSystem.Data
@using BookRecommendationSystem.Web.Components.Shared

@if (_error is not null)
{
    <DbUnavailableBanner Message="@_error" OnRetry="LoadAsync" />
}
else if (!_loaded)
{
    <LoadingSkeleton Rows="1" />
}
else if (_twin is null)
{
    <div class="empty-state">
        <p>No reading twin found yet — this reader hasn't overlapped enough with anyone else.</p>
    </div>
}
else
{
    <div class="twin-card">
        <h2>Your reading twin</h2>
        <p class="twin-name">@_twin.Value.TwinName</p>
        <p>
            You've both rated <strong>@_twin.Value.SharedBooks</strong> of the same books,
            averaging <strong>@_twin.Value.AvgScoreGap.ToString("0.0")</strong> stars apart.
        </p>
        <FollowButton ActorId="@ReaderId" TargetId="@_twin.Value.TwinId" InitialFollowing="@_isFollowingTwin" />
    </div>
}

@code {
    [Parameter] public string ReaderId { get; set; } = "";
    private (string TwinId, string TwinName, int SharedBooks, double AvgScoreGap)? _twin;
    private bool _isFollowingTwin;
    private bool _loaded;
    private string? _error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null; _loaded = false;
        StateHasChanged();
        try
        {
            _twin = await Repo.GetReadingTwinAsync(ReaderId);
            if (_twin is not null)
            {
                var following = await FollowRepo.GetFollowingAsync(ReaderId);
                _isFollowingTwin = following.Any(f => f.Id == _twin.Value.TwinId);
            }
        }
        catch (DatabaseUnavailableException ex) { _error = ex.Message; }
        finally { _loaded = true; }
    }
}
